{
  "manifest_version": 3,
  "name": "Kiosque",
  "version": "0.1.0",
  "description": "Les actualités de tes sources (flux RSS et Atom) sur une seule page, sans compte ni serveur.",
  "action": {
    "default_title": "Ouvrir les actualités"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://feeds.bbci.co.uk/*",
    "https://www.france24.com/*",
    "https://www.franceinfo.fr/*",
    "https://news.google.com/*",
    "https://www.aljazeera.com/*",
    "https://www.theguardian.com/*",
    "https://feeds.npr.org/*",
    "https://rss.nytimes.com/*",
    "https://www.rfi.fr/*",
    "https://www.lemonde.fr/*",
    "https://www.lemondeinformatique.fr/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
